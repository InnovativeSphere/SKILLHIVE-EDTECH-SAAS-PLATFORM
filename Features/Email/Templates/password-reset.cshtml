<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { margin:0; padding:0; background:#f4f4f4; font-family: Arial, sans-serif; }
    .container { max-width:600px; margin:20px auto; background:#ffffff; border-radius:8px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.05); }
    .header { background-color:#2D2D2D; padding:24px; text-align:center; color:#ffffff; }
    .header h1 { margin:0; font-size:20px; letter-spacing:1px; }
    .content { padding:32px; color:#333333; }
    .content h2 { margin-top:0; color:#2D2D2D; }
    .content p { line-height:1.6; }
    .button { display:inline-block; margin-top:20px; padding:12px 24px; background-color:#2D2D2D; color:#ffffff !important; text-decoration:none; border-radius:5px; font-weight:bold; }
    .link-fallback { margin-top:24px; padding:12px; background:#FAFAFA; border:1px solid #E5E5E5; border-radius:5px; font-size:12px; color:#666666; word-break:break-all; }
    .warning { margin-top:24px; padding:12px; background:#FFF7ED; border-left:3px solid #D96600; font-size:13px; color:#666666; }
    .footer { background:#f9fafb; padding:20px; text-align:center; font-size:12px; color:#666666; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>@Model.PlatformName</h1>
    </div>
    <div class="content">
      <h2>Password Reset Request</h2>
      <p>Hi @Model.FullName,</p>
      <p>We received a request to reset your password. Click the button below to choose a new one.</p>
      <a href="@Model.ResetLink" class="button">Reset My Password</a>
      <p style="margin-top:24px;">This link expires in <strong>@Model.ExpiryMinutes minutes</strong>.</p>
      <div class="link-fallback">
        Button not working? Paste this link into your browser:<br />
        @Model.ResetLink
      </div>
      <div class="warning">
        If you didn't request a password reset, you can safely ignore this email. Your password won't change.
      </div>
    </div>
    <div class="footer">
      <p>&copy; @DateTime.UtcNow.Year @Model.PlatformName. All rights reserved.</p>
    </div>
  </div>
</body>
</html>