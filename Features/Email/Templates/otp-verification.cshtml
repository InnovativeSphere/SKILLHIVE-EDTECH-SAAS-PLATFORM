<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { margin:0; padding:0; background:#f4f4f4; font-family: Arial, sans-serif; }
    .container { max-width:600px; margin:20px auto; background:#ffffff; border-radius:8px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.05); }
    .header { background-color:#2D2D2D; padding:24px; text-align:center; color:#ffffff; }
    .header h1 { margin:0; font-size:20px; letter-spacing:1px; }
    .content { padding:32px; color:#333333; text-align:center; }
    .content h2 { margin-top:0; color:#2D2D2D; }
    .content p { line-height:1.6; }
    .otp-box { display:inline-block; margin:24px 0; padding:20px 40px; background:#FAFAFA; border:2px dashed #D1D1D1; border-radius:8px; font-size:32px; font-weight:bold; letter-spacing:12px; color:#2D2D2D; }
    .footer { background:#f9fafb; padding:20px; text-align:center; font-size:12px; color:#666666; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>@Model.PlatformName</h1>
    </div>
    <div class="content">
      <h2>Hi @Model.FullName,</h2>
      <p>Use the code below to verify your email address:</p>
      <div class="otp-box">@Model.Otp</div>
      <p>This code expires in <strong>@Model.ExpiryMinutes minutes</strong>.</p>
      <p style="margin-top:24px; color:#9A9A9A;">If you didn't request this, you can safely ignore this email.</p>
    </div>
    <div class="footer">
      <p>&copy; @DateTime.UtcNow.Year @Model.PlatformName. All rights reserved.</p>
    </div>
  </div>
</body>
</html>