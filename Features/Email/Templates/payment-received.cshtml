<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { margin:0; padding:0; background:#f4f4f4; font-family: Arial, sans-serif; }
    .container { max-width:600px; margin:20px auto; background:#ffffff; border-radius:8px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.05); }
    .header { background-color:#2D2D2D; padding:24px; text-align:center; color:#ffffff; }
    .header h1 { margin:0; font-size:20px; letter-spacing:1px; }
    .content { padding:32px; color:#333333; text-align:left; }
    .content h2 { margin-top:0; color:#2D2D2D; text-align:center; }
    .content p { line-height:1.6; }
    .receipt { margin:24px 0; border:1px solid #E5E5E5; border-radius:8px; overflow:hidden; }
    .receipt-row { display:flex; justify-content:space-between; padding:12px 20px; border-bottom:1px solid #F0F0F0; font-size:14px; }
    .receipt-row:last-child { border-bottom:none; }
    .receipt-label { color:#888888; }
    .receipt-value { color:#2D2D2D; font-weight:bold; }
    .amount-box { text-align:center; margin:24px 0; padding:20px; background:#FAFAFA; border:2px dashed #D1D1D1; border-radius:8px; font-size:28px; font-weight:bold; color:#2D2D2D; }
    .footer { background:#f9fafb; padding:20px; text-align:center; font-size:12px; color:#666666; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>@Model.PlatformName</h1>
    </div>
    <div class="content">
      <h2>Payment Received</h2>
      <p>Hi @Model.FullName,</p>
      <p>We've successfully received your payment. Thank you!</p>

      <div class="amount-box">@Model.Currency @Model.Amount</div>

      <div class="receipt">
        <div class="receipt-row">
          <span class="receipt-label">Reference</span>
          <span class="receipt-value">@Model.Reference</span>
        </div>
        <div class="receipt-row">
          <span class="receipt-label">Date</span>
          <span class="receipt-value">@Model.PaidAt.ToString("MMMM dd, yyyy HH:mm")</span>
        </div>
        @if (!string.IsNullOrEmpty(Model.CourseTitle))
        {
        <div class="receipt-row">
          <span class="receipt-label">Course</span>
          <span class="receipt-value">@Model.CourseTitle</span>
        </div>
        }
      </div>

      <p style="margin-top:24px; color:#9A9A9A; font-size:13px;">Keep this receipt for your records. If you have any questions, reply to this email.</p>
    </div>
    <div class="footer">
      <p>&copy; @DateTime.UtcNow.Year @Model.PlatformName. All rights reserved.</p>
    </div>
  </div>
</body>
</html>